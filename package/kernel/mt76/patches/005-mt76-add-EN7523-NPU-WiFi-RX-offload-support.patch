--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -578,6 +578,20 @@
 	if (ret < 0)
 		return ret;
 
+#if IS_ENABLED(CONFIG_NET_AIROHA_NPU)
+	/* NPU WiFi RX offload init: after NAPI setup, before DMA enable */
+	if (dev->npu) {
+		ret = mt7915_mmio_npu_init(dev);
+		if (ret) {
+			dev_warn(mdev->dev,
+				 "NPU init failed (%d), using normal DMA\n",
+				 ret);
+			airoha_npu_put(dev->npu);
+			dev->npu = NULL;
+		}
+	}
+#endif
+
