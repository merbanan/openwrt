+#if IS_ENABLED(CONFIG_NET_AIROHA_NPU)
+
+static irqreturn_t mt7915_npu_irq_handler(int irq, void *data)
+{
+	struct mt7915_dev *dev = data;
+	struct mt76_dev *mdev = &dev->mt76;
+	u32 status;
+
+	/* ack and disable IRQ until NAPI re-enables it */
+	status = airoha_npu_wlan_get_irq_status(dev->npu, dev->npu_band_idx);
+	airoha_npu_wlan_set_irq_status(dev->npu, status);
+	airoha_npu_wlan_disable_irq(dev->npu, dev->npu_band_idx);
+
+	napi_schedule(&mdev->napi[MT_RXQ_MAIN]);
+	return IRQ_HANDLED;
+}
+
+static int mt7915_npu_rx_fill_slot(struct mt7915_dev *dev, int idx)
+{
+	struct mt7915_npu_rx_ring *ring = &dev->npu_rx;
+	struct sk_buff *skb;
+	dma_addr_t dma_addr;
+
+	skb = dev_alloc_skb(MT7915_NPU_SKB_SIZE);
+	if (!skb)
+		return -ENOMEM;
+
+	dma_addr = dma_map_single(dev->mt76.dev, skb->data,
+				  MT7915_NPU_SKB_SIZE, DMA_FROM_DEVICE);
+	if (dma_mapping_error(dev->mt76.dev, dma_addr)) {
+		dev_kfree_skb(skb);
+		return -ENOMEM;
+	}
+
+	ring->skbs[idx] = skb;
+	ring->skb_dma[idx] = dma_addr;
+	ring->desc[idx].addr = dma_addr;
+	ring->desc[idx].ctrl = 0;
+	ring->desc[idx].info = 0;
+	ring->desc[idx].data = 0;
+	ring->desc[idx].rsv = 0;
+	return 0;
+}
+
+void mt7915_npu_rx_ring_free(struct mt7915_dev *dev)
+{
+	struct mt7915_npu_rx_ring *ring = &dev->npu_rx;
+	int i;
+
+	if (!ring->desc)
+		return;
+
+	for (i = 0; i < ring->size; i++) {
+		if (ring->skbs && ring->skbs[i]) {
+			dma_unmap_single(dev->mt76.dev, ring->skb_dma[i],
+					 MT7915_NPU_SKB_SIZE, DMA_FROM_DEVICE);
+			dev_kfree_skb(ring->skbs[i]);
+		}
+	}
+
+	kfree(ring->skb_dma);
+	kfree(ring->skbs);
+	dma_free_coherent(dev->mt76.dev,
+			  ring->size * sizeof(*ring->desc),
+			  ring->desc, ring->desc_dma);
+	ring->desc = NULL;
+	ring->skbs = NULL;
+	ring->skb_dma = NULL;
+}
+
+static int mt7915_npu_rx_ring_alloc(struct mt7915_dev *dev)
+{
+	struct mt7915_npu_rx_ring *ring = &dev->npu_rx;
+	int i, ret;
+
+	ring->size = MT7915_NPU_RX_RING_SIZE;
+	ring->dma_idx = 0;
+
+	ring->desc = dma_alloc_coherent(dev->mt76.dev,
+					ring->size * sizeof(*ring->desc),
+					&ring->desc_dma, GFP_KERNEL);
+	if (!ring->desc)
+		return -ENOMEM;
+
+	ring->skbs = kcalloc(ring->size, sizeof(*ring->skbs), GFP_KERNEL);
+	if (!ring->skbs) {
+		ret = -ENOMEM;
+		goto free_desc;
+	}
+
+	ring->skb_dma = kcalloc(ring->size, sizeof(*ring->skb_dma), GFP_KERNEL);
+	if (!ring->skb_dma) {
+		ret = -ENOMEM;
+		goto free_skbs;
+	}
+
+	for (i = 0; i < ring->size; i++) {
+		ret = mt7915_npu_rx_fill_slot(dev, i);
+		if (ret)
+			goto free_ring;
+	}
+
+	return 0;
+
+free_ring:
+	while (--i >= 0) {
+		dma_unmap_single(dev->mt76.dev, ring->skb_dma[i],
+				 MT7915_NPU_SKB_SIZE, DMA_FROM_DEVICE);
+		dev_kfree_skb(ring->skbs[i]);
+	}
+	kfree(ring->skb_dma);
+	ring->skb_dma = NULL;
+free_skbs:
+	kfree(ring->skbs);
+	ring->skbs = NULL;
+free_desc:
+	dma_free_coherent(dev->mt76.dev,
+			  ring->size * sizeof(*ring->desc),
+			  ring->desc, ring->desc_dma);
+	ring->desc = NULL;
+	return ret;
+}
+
+int mt7915_mmio_npu_init(struct mt7915_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	struct airoha_npu *npu = dev->npu;
+	int band = dev->npu_band_idx;
+	u32 val, rxdesc_base;
+	int ret;
+
+	ret = mt7915_npu_rx_ring_alloc(dev);
+	if (ret)
+		return ret;
+
+	/* Tell NPU where to write processed frames (host-adapter ring) */
+	ret = airoha_npu_wlan_rx_ring_setup(npu, band,
+					     dev->npu_rx.desc_dma,
+					     dev->npu_rx.size);
+	if (ret)
+		goto free_ring;
+
+	/* WiFi chip variant */
+	val = is_mt7916(mdev) ? WLAN_MT7916_DBDC : WLAN_MT7915A;
+	ret = airoha_npu_wlan_send_msg(npu, band,
+				       WLAN_FUNC_SET_WAIT_DRIVER_MODEL,
+				       &val, sizeof(val), GFP_KERNEL);
+	if (ret)
+		goto free_ring;
+
+	/* PCIe port type (matches linux,pci-domain in DTS) */
+	val = band ? WLAN_PORT1 : WLAN_PORT0;
+	ret = airoha_npu_wlan_send_msg(npu, band,
+				       WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE,
+				       &val, sizeof(val), GFP_KERNEL);
+	if (ret)
+		goto free_ring;
+
+	/* Physical address of WiFi DMA ring base register in PCIe BAR0 */
+	val = (u32)(dev->phys_base + MT_RXQ_RING_BASE(MT_RXQ_MAIN));
+	ret = airoha_npu_wlan_send_msg(npu, band,
+				       WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+				       &val, sizeof(val), GFP_KERNEL);
+	if (ret)
+		goto free_ring;
+
+	/* Number of descriptors for NPU internal WiFi DMA ring */
+	val = MT7915_NPU_WIFI_DESC_NUM;
+	ret = airoha_npu_wlan_send_msg(npu, band,
+				       WLAN_FUNC_SET_WAIT_DESC,
+				       &val, sizeof(val), GFP_KERNEL);
+	if (ret)
+		goto free_ring;
+
+	/* NPU reserved memory (BA nodes, packet buffers) */
+	ret = airoha_npu_wlan_init_reserved_memory(npu);
+	if (ret)
+		goto free_ring;
+
+	/* Signal NPU that WiFi-side init is complete */
+	val = 1;
+	ret = airoha_npu_wlan_send_msg(npu, band,
+				       WLAN_FUNC_SET_WAIT_NPU_INIT_DONE,
+				       &val, sizeof(val), GFP_KERNEL);
+	if (ret)
+		goto free_ring;
+
+	/* Get NPU internal WiFi DMA ring base, redirect WiFi DMA to it */
+	ret = airoha_npu_wlan_get_msg(npu, band,
+				      WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+				      &rxdesc_base, sizeof(rxdesc_base),
+				      GFP_KERNEL);
+	if (ret)
+		goto free_ring;
+
+	writel(rxdesc_base, &mdev->q_rx[MT_RXQ_MAIN].regs->desc_base);
+
+	/* Register NPU WLAN IRQ */
+	ret = devm_request_irq(mdev->dev, npu->irqs[band],
+			       mt7915_npu_irq_handler, 0,
+			       "mt7915-npu-rx", dev);
+	if (ret)
+		goto free_ring;
+
+	airoha_npu_wlan_enable_irq(npu, band);
+	dev_info(mdev->dev, "NPU WiFi RX offload enabled (band %d)\n", band);
+	return 0;
+
+free_ring:
+	mt7915_npu_rx_ring_free(dev);
+	return ret;
+}
+
+static int mt7915_npu_rx_process(struct mt76_dev *mdev, int qid, int budget)
+{
+	struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
+	struct mt7915_npu_rx_ring *ring = &dev->npu_rx;
+	int done = 0;
+
+	if (!dev->npu || qid != MT_RXQ_MAIN)
+		return -ENODEV;
+
+	while (done < budget) {
+		struct airoha_npu_rx_dma_desc *desc;
+		struct sk_buff *skb;
+		u32 cpu_idx, len, info = 0;
+		int idx = ring->dma_idx;
+
+		cpu_idx = airoha_npu_wlan_rx_get_cpu_idx(dev->npu,
+							  dev->npu_band_idx);
+		if (idx == cpu_idx)
+			break;
+
+		desc = &ring->desc[idx];
+		if (!(desc->ctrl & NPU_RX_DMA_DESC_DONE_MASK))
+			break;
+
+		len = FIELD_GET(NPU_RX_DMA_DESC_CUR_LEN_MASK, desc->ctrl);
+		skb = ring->skbs[idx];
+
+		dma_unmap_single(mdev->dev, ring->skb_dma[idx],
+				 MT7915_NPU_SKB_SIZE, DMA_FROM_DEVICE);
+
+		/* Refill slot before handing skb upward */
+		if (mt7915_npu_rx_fill_slot(dev, idx)) {
+			/* OOM: restore the slot and stop */
+			ring->skbs[idx] = skb;
+			ring->skb_dma[idx] = dma_map_single(mdev->dev,
+				skb->data, MT7915_NPU_SKB_SIZE, DMA_FROM_DEVICE);
+			desc->ctrl = 0;
+			break;
+		}
+
+		ring->dma_idx = (idx + 1) % ring->size;
+		airoha_npu_wlan_rx_set_dma_idx(dev->npu, dev->npu_band_idx,
+					       ring->dma_idx);
+
+		skb_put(skb, len);
+		*(u32 *)skb->cb = info;
+		mdev->drv->rx_skb(mdev, MT_RXQ_MAIN, skb, &info);
+		done++;
+	}
+
+	return done;
+}
+
+#endif /* CONFIG_NET_AIROHA_NPU */
