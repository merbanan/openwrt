 			  mt7915_poll_tx);
 	napi_enable(&dev->mt76.tx_napi);
@@ -651,5 +665,9 @@
 {
 	mt7915_dma_disable(dev, true);
 
+#if IS_ENABLED(CONFIG_NET_AIROHA_NPU)
+	mt7915_npu_rx_ring_free(dev);
+#endif
+
 	mt76_dma_cleanup(&dev->mt76);
 }
--- a/mt7915/mmio.c
+++ b/mt7915/mmio.c
