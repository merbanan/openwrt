+#define ROUND_TRIP_DELAY_CTRL		0x02CC
+#define ROUND_TRIP_CAL_MASK_CTRL	0x02D0
+#define ROUND_TRIP_DELAY_VALUE		0x02D4
+#define   ROUND_TRIP_DELAY_VALUE_PSYNC_TO_TX_DELAY GENMASK(31, 16)
+#define   ROUND_TRIP_DELAY_VALUE_PSYNC_TO_SOF_DELAY GENMASK(15, 0)
+#define ROUND_TRIP_DELAY_VALUE_STATIC	0x02D8
+#define PSYNC_DET_ALIGN_PHASE		0x02DC
+#define RX_TX_HEAD_TO_HEAD_DELAY	0x02E0
+#define MGMII_PHY_DELAY			0x03A0
+
+/* TX Configuration Registers */
+#define GPON_PREAMBLE			0x0400
+#define   GPON_PREAMBLE_T3_PAT		GENMASK(31, 24)
+#define   GPON_PREAMBLE_T2_NUM		GENMASK(23, 16)
+#define   GPON_PREAMBLE_T1_NUM		GENMASK(15, 8)
+#define   GPON_PREAMBLE_GUARD_BITS_NUM	GENMASK(7, 0)
+#define   GPON_PREAMBLE_RESET_VAL	0xAA080820
+
+#define GPON_DELIMITER_GUARD		0x0404
+#define   GPON_DELIMITER_GUARD_GUARD_PAT   GENMASK(31, 24)
+#define   GPON_DELIMITER_GUARD_DELIMITER_PAT GENMASK(23, 0)
+#define   GPON_DELIMITER_GUARD_INIT_VAL	0xAAAB5983
+
+#define GPON_EXTENDED_PREAMBLE		0x0408
+#define   GPON_EXTENDED_PREAMBLE_OVHEAD_SRAM_OPTION BIT(26)
+#define   GPON_EXTENDED_PREAMBLE_OVHEAD_USE_SRAM   BIT(25)
+#define   GPON_EXTENDED_PREAMBLE_DIS_SCRAMBLE	    BIT(24)
+#define   GPON_EXTENDED_PREAMBLE_OPER_RANGED_ST	    GENMASK(18, 17)
+#define   GPON_EXTENDED_PREAMBLE_EXTEND_BURST_MODE  BIT(16)
+#define   GPON_EXTENDED_PREAMBLE_T3_ASS_NUM	    GENMASK(15, 8)
+#define   GPON_EXTENDED_PREAMBLE_T3_PRE_NUM	    GENMASK(7, 0)
+
+#define PHYTX_STATUS			0x040C
+#define EPON_TX_CTL			0x0410
+#define   EPON_TX_CTL_DLYBND_DELSEL	GENMASK(15, 14)
+#define   EPON_TX_CTL_EPSRAM_DELSEL	GENMASK(13, 12)
+#define   EPON_TX_CTL_DIS_ENC8B10B	BIT(8)
+#define   EPON_TX_CTL_EPON_TX_DELAY_BOUND GENMASK(6, 0)
+
+#define EPON_LOOPBAK_MODE		0x0428
+#define TX_FRAME_COUNTER		0x0434
+#define TX_BURST_COUNTER		0x0438
+#define TX_FEC_FRAME_COUNTER		0x043C
+#define FECENC_STATUS			0x0450
+#define TX_MULT2			0x0490
+#define BISTCTL_LOOPBACK_SEL		0x04A0
+#define   BISTCTL_LOOPBACK_SEL_PRBS7_LB	0x5
+#define BISTCTL_PRBS_TX_EN		0x04A4
+#define CID_LENGTH_SEL			0x04B0
+
+/* Test Frame Registers */
+#define TEST_FRAME_EN			0x0510
+#define TEST_FRAME_NUM			0x0514
+#define TEST_FRAME_MAX_LENGTH		0x0518
+#define TEST_FRAME_MIN_LENGTH		0x051C
+#define TF_PAT_SEL			0x0520
+#define TEST_FRAME_ERR_CNT		0x0524
+#define TEST_FRAME_TX_INFO		0x0528
+#define TEST_FRAME_DONE			0x052C
+
+/* EPON Test Frame Content Registers */
+#define EPON_SPD			0x0530
+#define EPON_PREAMBLE0			0x0534
+#define EPON_PREAMBLE1			0x0538
+#define EPON_SFD			0x053C
+#define EPON_TF_DST0			0x0540
+#define EPON_TF_DST1			0x0544
+#define EPON_TF_SRC0			0x0548
+#define EPON_TF_SRC1			0x054C
+#define EPON_TF_LEN_TYPE		0x0550
+
+/* Interrupt Registers */
+#define XPON_STA			0x05E0
+#define   XPON_STA_LOS			BIT(0)
+
+#define GIO1_SETTING			0x05E8
+#define   GIO1_SETTING_GIO1_IN		BIT(1)
+#define   GIO1_SETTING_GIO0_IN		BIT(0)
+
+#define GIO2_SETTING			0x05EC
+#define   GIO2_SETTING_GIO_OUT		BIT(0)
+
+#define XPON_INT_EN			0x05F0
+#define   XPON_INT_EN_I2CM_IRQ_INT_EN	BIT(7)
+#define   XPON_INT_EN_ILLEGAL_INT_EN	BIT(6)
+#define   XPON_INT_EN_PHYRDY_INT_EN	BIT(5)
+#define   XPON_INT_EN_TRANS_SD_FAIL_INT_EN BIT(4)
+#define   XPON_INT_EN_TRANS_INT_EN	BIT(3)
+#define   XPON_INT_EN_TRANS_FAULT_INT_EN BIT(2)
+#define   XPON_INT_EN_LOF_INT_EN	BIT(1)
+#define   XPON_INT_EN_TRANS_LOS_INT_EN	BIT(0)
+
+#define XPON_INT_STA_CLR		0x05F4	/* W1C */
+#define XPON_INT_STA			0x05F8
+#define   XPON_INT_STA_I2CM_IRQ_INT	BIT(7)
+#define   XPON_INT_STA_ILLEGAL_INT	BIT(6)
+#define   XPON_INT_STA_PHYRDY_INT	BIT(5)
+#define   XPON_INT_STA_TRANS_SD_FAIL_INT BIT(4)
+#define   XPON_INT_STA_TRANS_INT	BIT(3)
+#define   XPON_INT_STA_TRANS_FAULT_INT	BIT(2)
+#define   XPON_INT_STA_LOF_INT		BIT(1)
+#define   XPON_INT_STA_TRANS_LOS_INT	BIT(0)
+/* Alias for all interrupts mask */
+#define   XPON_INT_ALL			GENMASK(7, 0)
+
+#define EPON_TF_ASYNC_FIFO		0x05FC
+
+/* Interrupt enable mask depending on chip variant */
+#define INT_EN_EN7521  (XPON_INT_EN_ILLEGAL_INT_EN | XPON_INT_EN_PHYRDY_INT_EN | \
+			XPON_INT_EN_LOF_INT_EN | XPON_INT_EN_TRANS_LOS_INT_EN)
+#define INT_EN_DEFAULT (XPON_INT_EN_PHYRDY_INT_EN | XPON_INT_EN_LOF_INT_EN | \
+			XPON_INT_EN_TRANS_LOS_INT_EN)
+
+/* PHY ready poll interval: 100 ms */
+#define PON_PHY_POLL_MS			100
+
+enum airoha_pon_mode {
+	PON_MODE_UNKNOWN,
+	PON_MODE_GPON,
+	PON_MODE_EPON,
+};
+
+/**
+ * struct airoha_en7512_pon - driver private data
+ * @dev:	pointer to the platform device
+ * @base:	MMIO base address
+ * @irq:	interrupt line
+ * @mode:	current GPON/EPON mode
+ * @phy_ready:	true when PHY has reached DR_PHYRDY state
+ * @los:	true when Loss of Signal is active
+ * @has_illegal_int: chip has illegal interrupt (EN7521 and later)
+ * @poll_timer:	fallback polling timer for LOS / PHY ready detection
+ * @debugfs_dir: debugfs directory entry
+ * @irq_count:	interrupt storm counter
+ * @irq_window_start: jiffies at the start of the current storm window
+ */
+struct airoha_en7512_pon {
+	struct device		*dev;
+	void __iomem		*base;
+	int			irq;
+	enum airoha_pon_mode	mode;
+	bool			phy_ready;
+	bool			los;
+	bool			has_illegal_int;
+	struct timer_list	poll_timer;
+	struct dentry		*debugfs_dir;
+	unsigned int		irq_count;
+	unsigned long		irq_window_start;
+};
+
+static inline u32 pon_phy_rd(struct airoha_en7512_pon *priv, u32 reg)
+{
+	return ioread32(priv->base + reg);
+}
+
+static inline void pon_phy_wr(struct airoha_en7512_pon *priv, u32 reg, u32 val)
+{
+	iowrite32(val, priv->base + reg);
+}
+
+static inline void pon_phy_rmw(struct airoha_en7512_pon *priv, u32 reg,
+			    u32 mask, u32 val)
+{
+	u32 tmp = pon_phy_rd(priv, reg);
+
+	pon_phy_wr(priv, reg, (tmp & ~mask) | (val & mask));
+}
+
+/* PHY state helpers */
+
+static bool pon_phy_is_ready(struct airoha_en7512_pon *priv)
+{
+	u32 val = pon_phy_rd(priv, PHYSTA1);
+
+	return FIELD_GET(PHYSTA1_PHY_CURR, val) == PHYSTA1_PHY_CURR_DR_PHYRDY;
+}
+
+static bool pon_phy_is_los(struct airoha_en7512_pon *priv)
+{
+	return !!(pon_phy_rd(priv, XPON_STA) & XPON_STA_LOS);
+}
+
+static bool pon_phy_is_rx_sync(struct airoha_en7512_pon *priv)
+{
+	u32 val = pon_phy_rd(priv, PHYRX_STATUS);
+
+	return FIELD_GET(PHYRX_STATUS_PHY_SYNC_STATUS, val) == PHYRX_STATUS_SYNC_VAL;
+}
+
+/* Counter management */
+
+static void pon_phy_counters_enable(struct airoha_en7512_pon *priv)
+{
+	u32 val;
+
+	val = pon_phy_rd(priv, XP_ERRCNT_EN);
+	val &= ~GENMASK(2, 0);
+	val |= XP_ERRCNT_EN_ERRCNT_EN | XP_ERRCNT_EN_BIPCNT_EN |
+	       XP_ERRCNT_EN_FMCNT_EN;
+	pon_phy_wr(priv, XP_ERRCNT_EN, val);
+
+	/* Clear all counters after enabling */
+	pon_phy_wr(priv, XP_ERRCNT_CTL,
+	       XP_ERRCNT_CTL_ERRCNT_CLR | XP_ERRCNT_CTL_BIPCNT_CLR |
+	       XP_ERRCNT_CTL_FMCNT_CLR);
+}
+
+static void pon_phy_counters_clear(struct airoha_en7512_pon *priv)
+{
+	pon_phy_wr(priv, XP_ERRCNT_CTL,
+	       XP_ERRCNT_CTL_ERRCNT_CLR | XP_ERRCNT_CTL_BIPCNT_CLR |
+	       XP_ERRCNT_CTL_FMCNT_CLR);
+}
+
+/* Interrupt management */
+
+static void pon_phy_int_enable(struct airoha_en7512_pon *priv)
+{
+	u32 mask = priv->has_illegal_int ? INT_EN_EN7521 : INT_EN_DEFAULT;
+
+	pon_phy_rmw(priv, XPON_INT_EN, XPON_INT_ALL, mask);
+}
+
+/* TX bit delay — clears any previously programmed delay */
+static void pon_phy_bit_delay_clear(struct airoha_en7512_pon *priv)
+{
+	u32 val = pon_phy_rd(priv, PHYSET5);
+
+	/* EN7521/MT7520: clear txbit_dly_sel [22:19] and set txbdelay_sel */
+	val &= ~PHYSET5_TXBIT_DLY_SEL;
+	val |= PHYSET5_TXBDELAY_SEL;
+	pon_phy_wr(priv, PHYSET5, val);
+}
+
+/* PLL + soft reset sequence */
+static void pon_phy_pll_reset(struct airoha_en7512_pon *priv)
+{
+	u32 orig = pon_phy_rd(priv, PHYSET3);
+	u32 val = orig | PHYSET3_PLLRST | PHYSET3_XP_SRST;
+
+	pon_phy_wr(priv, PHYSET3, val);
+	mdelay(1);
+	pon_phy_wr(priv, PHYSET3, orig);
+}
+
+/* Signal-detect / ESD deglitch clear */
+static void pon_phy_esd_deglitch_clear(struct airoha_en7512_pon *priv)
+{
+	pon_phy_rmw(priv, PHYSET3, PHYSET3_ESD_PRO, 0);
+}
+
+/* Set firmware ready bit in PHYSET2 (must be set last, after MAC ready) */
+static void pon_phy_fw_ready_set(struct airoha_en7512_pon *priv, bool ready)
+{
+	if (ready)
+		pon_phy_rmw(priv, PHYSET2, PHYSET2_FWRDY, PHYSET2_FWRDY);
+	else
+		pon_phy_rmw(priv, PHYSET2, PHYSET2_FWRDY, 0);
+}
+
+/*
+ * Core initialization sequence.
+ * Called after top-level PHY reset has been released and PBUS enabled.
+ */
+static void pon_phy_dev_init(struct airoha_en7512_pon *priv)
+{
+	pon_phy_esd_deglitch_clear(priv);
+	pon_phy_counters_enable(priv);
+	pon_phy_wr(priv, GPON_DELIMITER_GUARD, GPON_DELIMITER_GUARD_INIT_VAL);
+	pon_phy_counters_clear(priv);
+	pon_phy_int_enable(priv);
+}
+
+/*
+ * Transceiver interface polarity configuration.
+ *
+ * The four inversion bits in XPON_SETTING describe the electrical polarity of
+ * the signals between the SerDes and the optical transceiver.  They are
+ * board/transceiver-specific and must be set from DT rather than inferred at
+ * runtime.  Absent properties leave the corresponding bit clear (non-inverted).
+ *
+ *   airoha,burst-en-inverted  — burst-enable input to the PHY is active-low
+ *   airoha,rx-sd-inverted     — RX signal-detect from the transceiver is
+ *                               active-low (LOS convention rather than SD)
+ *   airoha,tx-fault-inverted  — TX fault output is active-low
+ *   airoha,tx-sd-inverted     — TX signal-detect output is active-low
+ */
+static void pon_phy_transceiver_polarity_init(struct airoha_en7512_pon *priv)
+{
+	struct device *dev = priv->dev;
+	u32 mask, val = 0;
+
+	mask = XPON_SETTING_TRANS_BURST_INV  |
+	       XPON_SETTING_TRANS_RX_SD_INV  |
+	       XPON_SETTING_TRANS_TX_FAULT_INV |
+	       XPON_SETTING_TRANS_TX_SD_INV;
+
+	if (device_property_read_bool(dev, "airoha,burst-en-inverted"))
+		val |= XPON_SETTING_TRANS_BURST_INV;
+	if (device_property_read_bool(dev, "airoha,rx-sd-inverted"))
+		val |= XPON_SETTING_TRANS_RX_SD_INV;
+	if (device_property_read_bool(dev, "airoha,tx-fault-inverted"))
+		val |= XPON_SETTING_TRANS_TX_FAULT_INV;
+	if (device_property_read_bool(dev, "airoha,tx-sd-inverted"))
+		val |= XPON_SETTING_TRANS_TX_SD_INV;
+
+	pon_phy_rmw(priv, XPON_SETTING, mask, val);
+}
+
+/*
+ * GPON/EPON mode configuration.
+ *
+ * The caller is responsible for disabling the optical transceiver (TX power)
+ * before calling this function and re-enabling it afterwards.  Switching the
+ * PHYSET10 GPON_MODE bit while the laser is active may produce spurious
+ * optical bursts on the fibre.
+ */
+static int pon_phy_mode_set(struct airoha_en7512_pon *priv,
+			enum airoha_pon_mode mode)
+{
+	u32 val;
+
+	if (mode == priv->mode)
+		return 0;
+
+	if (mode == PON_MODE_GPON) {
+		/* GPON uses burst TX: clear TXEN */
+		pon_phy_rmw(priv, PHYSET3, PHYSET3_TXEN, 0);
+		pon_phy_rmw(priv, PHYSET10, PHYSET10_GPON_MODE, PHYSET10_GPON_MODE);
+		pon_phy_pll_reset(priv);
+
+	} else if (mode == PON_MODE_EPON) {
+		/*
+		 * EPON needs continuous TX.  Start in burst mode to let the
+		 * PLL settle before switching to continuous.
+		 */
+		pon_phy_rmw(priv, PHYSET3, PHYSET3_TXEN, 0);
+		pon_phy_rmw(priv, PHYSET10, PHYSET10_GPON_MODE, 0);
+		pon_phy_pll_reset(priv);
+		/* Switch to continuous TX after PLL has settled */
+		val = pon_phy_rd(priv, PHYSET3);
+		val |= PHYSET3_TXEN;
+		pon_phy_wr(priv, PHYSET3, val);
+
+	} else {
+		return -EINVAL;
+	}
+
+	priv->mode = mode;
+	return 0;
+}
+
+/* LOS handler: clear bit delay, reset counters, notify */
+static void pon_phy_los_handler(struct airoha_en7512_pon *priv)
+{
+	priv->los = true;
+	priv->phy_ready = false;
+
+	pon_phy_bit_delay_clear(priv);
+	pon_phy_counters_clear(priv);
+
+	dev_dbg(priv->dev, "LOS asserted\n");
+}
+
+/* PHY ready handler: verify not a false positive */
+static void pon_phy_phyrdy_handler(struct airoha_en7512_pon *priv, u32 int_sta)
+{
+	/*
+	 * If LOS or ILLG occurred at the same time as PHYRDY, discard as
+	 * a false positive.
+	 */
+	if (int_sta & (XPON_INT_STA_TRANS_LOS_INT | XPON_INT_STA_ILLEGAL_INT)) {
+		dev_dbg(priv->dev, "Discarding false PHY ready interrupt\n");
+		return;
+	}
+
+	priv->phy_ready = true;
+	priv->los = false;
+
+	dev_info(priv->dev, "PHY ready, RX sync: %s\n",
+		 pon_phy_is_rx_sync(priv) ? "yes" : "no");
+}
+
+/* Interrupt storm: warn if 10 interrupts fire within 50 ms */
+#define PON_IRQ_STORM_COUNT	10
+#define PON_IRQ_STORM_MS	50
+
+static void pon_phy_irq_storm_check(struct airoha_en7512_pon *priv)
+{
+	if (priv->irq_count == 0)
+		priv->irq_window_start = jiffies;
+
+	if (++priv->irq_count == PON_IRQ_STORM_COUNT) {
+		priv->irq_count = 0;
+		if (time_before(jiffies,
+				priv->irq_window_start +
+				msecs_to_jiffies(PON_IRQ_STORM_MS)))
+			dev_warn_ratelimited(priv->dev, "interrupt storm detected\n");
+	}
+}
+
+static irqreturn_t pon_phy_isr(int irq, void *data)
+{
+	struct airoha_en7512_pon *priv = data;
+	u32 sta;
+
+	sta = pon_phy_rd(priv, XPON_INT_STA);
+	pon_phy_wr(priv, XPON_INT_STA_CLR, sta);
+
+	if (!sta)
+		return IRQ_NONE;
+
+	if (sta & (XPON_INT_STA_TRANS_LOS_INT | XPON_INT_STA_ILLEGAL_INT))
+		pon_phy_los_handler(priv);
+
+	if (sta & XPON_INT_STA_LOF_INT)
+		dev_dbg(priv->dev, "Loss of frame (GPON)\n");
+
+	if (sta & XPON_INT_STA_TRANS_FAULT_INT)
+		dev_warn(priv->dev, "Transceiver TX fault\n");
+
+	if (sta & XPON_INT_STA_TRANS_SD_FAIL_INT)
+		dev_warn(priv->dev, "Transceiver TX_SD signal failure\n");
+
+	if (sta & XPON_INT_STA_PHYRDY_INT)
+		pon_phy_phyrdy_handler(priv, sta);
+
+	pon_phy_irq_storm_check(priv);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Polling fallback timer. Fires every PON_PHY_POLL_MS ms to detect LOS and
+ * PHY ready transitions when the interrupt path is unavailable or unreliable.
+ */
+static void pon_phy_poll_timer_fn(struct timer_list *t)
+{
+	struct airoha_en7512_pon *priv = timer_container_of(priv, t, poll_timer);
+	bool los_now = pon_phy_is_los(priv);
+	bool rdy_now = pon_phy_is_ready(priv);
+
+	if (los_now && !priv->los)
+		pon_phy_los_handler(priv);
+
+	if (rdy_now && !priv->phy_ready && !los_now) {
+		priv->phy_ready = true;
+		priv->los = false;
+		dev_info(priv->dev, "PHY ready (polled), RX sync: %s\n",
+			 pon_phy_is_rx_sync(priv) ? "yes" : "no");
+	}
+
+	mod_timer(&priv->poll_timer, jiffies + msecs_to_jiffies(PON_PHY_POLL_MS));
+}
+
+/* debugfs */
+
+#ifdef CONFIG_DEBUG_FS
+
+static int pon_phy_dbg_status_show(struct seq_file *s, void *unused)
+{
+	struct airoha_en7512_pon *priv = s->private;
+	u32 sta1, rxsta, anacal1, anacal2, tdcsta1;
+
+	sta1   = pon_phy_rd(priv, PHYSTA1);
+	rxsta  = pon_phy_rd(priv, PHYRX_STATUS);
+	anacal1 = pon_phy_rd(priv, ANACAL1);
+	anacal2 = pon_phy_rd(priv, ANACAL2);
+	tdcsta1 = pon_phy_rd(priv, TDCSTA1);
+
+	seq_printf(s, "Mode       : %s\n",
+		   priv->mode == PON_MODE_GPON ? "GPON" :
+		   priv->mode == PON_MODE_EPON ? "EPON" : "UNKNOWN");
+	seq_printf(s, "PHY ready  : %s\n", priv->phy_ready ? "yes" : "no");
+	seq_printf(s, "LOS        : %s\n", priv->los ? "yes" : "no");
+	seq_printf(s, "RX sync    : %s\n", pon_phy_is_rx_sync(priv) ? "yes" : "no");
+	seq_printf(s, "PHYSTA1    : 0x%08x  (PHY FSM state: %lu)\n",
+		   sta1, FIELD_GET(PHYSTA1_PHY_CURR, sta1));
+	seq_printf(s, "PHYRX_STA  : 0x%08x\n", rxsta);
+	seq_printf(s, "ANACAL1    : 0x%08x  (TX imp: %lu, RX imp: %lu, sqoffset: %lu)\n",
+		   anacal1,
+		   FIELD_GET(ANACAL1_TXIMP_LAT, anacal1),
+		   FIELD_GET(ANACAL1_RXIMP_LAT, anacal1),
+		   FIELD_GET(ANACAL1_SQOFFSET_K, anacal1));
+	seq_printf(s, "ANACAL2    : 0x%08x  (TX VCO band: %lu, RX VCO: %lu)\n",
+		   anacal2,
+		   FIELD_GET(ANACAL2_PON_PLL_AUTOK_BAND_SCAN, anacal2),
+		   FIELD_GET(ANACAL2_RX_VCOCAL_STATE, anacal2));
+	seq_printf(s, "TDCSTA1    : 0x%08x  (TDC offset: %lu, gain: %lu)\n",
+		   tdcsta1,
+		   FIELD_GET(TDCSTA1_TDC_OFFSET, tdcsta1),
+		   FIELD_GET(TDCSTA1_TDC_GAIN, tdcsta1));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(pon_phy_dbg_status);
+
+static int pon_phy_dbg_counters_show(struct seq_file *s, void *unused)
+{
+	struct airoha_en7512_pon *priv = s->private;
+	u32 err_byte, err_code, nosol_code, rx_code, fec_sec, bip;
+	u32 frame_l, frame_h, lof_cnt;
+
+	/* Latch all counters simultaneously */
+	pon_phy_wr(priv, XP_ERRCNT_CTL,
+	       XP_ERRCNT_CTL_ERRCNT_LCH | XP_ERRCNT_CTL_BIPCNT_LCH |
+	       XP_ERRCNT_CTL_FMCNT_LCH);
+
+	err_byte   = pon_phy_rd(priv, ERR_BYTE_CNT);
+	err_code   = pon_phy_rd(priv, ERR_CODE_CNT);
+	nosol_code = pon_phy_rd(priv, NOSOL_CODE_CNT);
+	rx_code    = pon_phy_rd(priv, RX_CODE_CNT);
+	fec_sec    = pon_phy_rd(priv, FEC_SECONDS);
+	bip        = pon_phy_rd(priv, BIP_CNT);
+	frame_l    = pon_phy_rd(priv, FRAME_CNT_L);
+	frame_h    = pon_phy_rd(priv, FRAME_CNT_H);
+	lof_cnt    = pon_phy_rd(priv, LOF_CNT);
+
+	seq_printf(s, "FEC corrected bytes    : %u\n", err_byte);
+	seq_printf(s, "FEC corrected codewords: %u\n", err_code);
+	seq_printf(s, "FEC uncorrectable cwds : %u\n", nosol_code);
+	seq_printf(s, "Total RX codewords     : %u\n", rx_code);
+	seq_printf(s, "FEC error seconds      : %u\n", fec_sec);
+	seq_printf(s, "BIP errors             : %u\n", bip);
+	seq_printf(s, "RX frames              : %llu\n",
+		   ((u64)frame_h << 32) | frame_l);
+	if (priv->mode == PON_MODE_GPON)
+		seq_printf(s, "LOF count              : %u\n", lof_cnt);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(pon_phy_dbg_counters);
+
+static int pon_phy_dbg_regs_show(struct seq_file *s, void *unused)
+{
+	struct airoha_en7512_pon *priv = s->private;
+	static const struct {
+		const char *name;
+		u32 offset;
+	} regs[] = {
+		{ "PHYSET2",          PHYSET2 },
+		{ "PHYSET3",          PHYSET3 },
+		{ "PHYSET4",          PHYSET4 },
+		{ "PHYSET5",          PHYSET5 },
+		{ "PHYSET10",         PHYSET10 },
+		{ "PHYSET11",         PHYSET11 },
+		{ "PHYSAP",           PHYSAP },
+		{ "PHYSTA1",          PHYSTA1 },
+		{ "XPON_SETTING",     XPON_SETTING },
+		{ "ANASTA1",          ANASTA1 },
+		{ "ANACAL1",          ANACAL1 },
+		{ "ANACAL2",          ANACAL2 },
+		{ "ANACAL3",          ANACAL3 },
+		{ "ANACAL4",          ANACAL4 },
+		{ "TDCSET1",          TDCSET1 },
+		{ "TDCSTA1",          TDCSTA1 },
+		{ "MISC",             MISC },
+		{ "PHYRX_STATUS",     PHYRX_STATUS },
+		{ "GPON_PREAMBLE",    GPON_PREAMBLE },
+		{ "GPON_DELIM_GUARD", GPON_DELIMITER_GUARD },
+		{ "XPON_STA",         XPON_STA },
+		{ "XPON_INT_EN",      XPON_INT_EN },
+		{ "XPON_INT_STA",     XPON_INT_STA },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		seq_printf(s, "%-20s [0x%04x]: 0x%08x\n",
+			   regs[i].name, regs[i].offset,
+			   pon_phy_rd(priv, regs[i].offset));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(pon_phy_dbg_regs);
