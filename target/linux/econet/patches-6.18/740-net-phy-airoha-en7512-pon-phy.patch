+			      char *buf)
+{
+	struct airoha_en7512_pon *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", (int)pon_phy_is_ready(priv));
+}
+static DEVICE_ATTR_RO(phy_ready);
