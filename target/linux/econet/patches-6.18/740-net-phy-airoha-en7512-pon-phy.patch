+/* sysfs: expose mode and link state */
+
+static ssize_t mode_show(struct device *dev, struct device_attribute *attr,
+			 char *buf)
+{
+	struct airoha_en7512_pon *priv = dev_get_drvdata(dev);
+	const char *s;
+
+	switch (priv->mode) {
+	case PON_MODE_GPON: s = "gpon\n"; break;
+	case PON_MODE_EPON: s = "epon\n"; break;
+	default:            s = "unknown\n"; break;
+	}
+
+	return sysfs_emit(buf, "%s", s);
+}
+static DEVICE_ATTR_RO(mode);
