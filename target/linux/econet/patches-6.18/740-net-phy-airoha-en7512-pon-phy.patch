diff --git a/drivers/net/phy/airoha/Kconfig b/drivers/net/phy/airoha/Kconfig
new file mode 100644
index 000000000000..0bfae3ea7e9e
--- /dev/null
+++ b/drivers/net/phy/airoha/Kconfig
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config AIROHA_EN7512_PON_PHY
+	tristate "Airoha EN7512/EN7521/EN7526 GPON/EPON SERDES PHY"
+	depends on OF
+	help
+	  Driver for the GPON/EPON SERDES PHY (xp_csr_phy_all) found in
+	  Airoha EN7512, EN7521 and EN7526 series SoCs.
+
+	  The PHY supports dual-mode operation:
+	    - GPON ONU: DS 2.488 Gbps / US 1.244 Gbps
+	    - EPON ONU: DS 1.25 Gbps / US 1.25 Gbps
+
+	  Register access is 32-bit memory-mapped via PBUS.
+
+	  To compile this driver as a module, choose M here. The module
+	  will be called airoha-en7512-pon-phy.
diff --git a/drivers/net/phy/airoha/Makefile b/drivers/net/phy/airoha/Makefile
new file mode 100644
