+/* Platform driver probe / remove */
+
+static int airoha_en7512_pon_probe(struct platform_device *pdev)
+{
+	struct airoha_en7512_pon *priv;
+	struct resource *res;
+	int ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = &pdev->dev;
+	priv->mode = PON_MODE_UNKNOWN;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	priv->base = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	priv->irq = platform_get_irq_optional(pdev, 0);
+
+	priv->has_illegal_int = device_is_compatible(&pdev->dev,
+						      "airoha,en7521-pon-phy");
+
+	platform_set_drvdata(pdev, priv);
+
+	/* Core initialization */
+	pon_phy_dev_init(priv);
+
+	/* Transceiver interface polarity from DT */
+	pon_phy_transceiver_polarity_init(priv);
+
+	/* Mode is fixed per board: read from DT "pon-mode" property */
+	if (device_property_match_string(&pdev->dev, "pon-mode", "gpon") >= 0)
+		ret = pon_phy_mode_set(priv, PON_MODE_GPON);
+	else if (device_property_match_string(&pdev->dev, "pon-mode", "epon") >= 0)
+		ret = pon_phy_mode_set(priv, PON_MODE_EPON);
+	else
+		ret = -EINVAL;
+
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "missing or invalid 'pon-mode' property (gpon/epon)\n");
+
+	/* Register interrupt handler if available */
+	if (priv->irq > 0) {
+		/* Clear any pending interrupts before enabling */
+		pon_phy_wr(priv, XPON_INT_STA_CLR, XPON_INT_ALL);
+
+		ret = devm_request_irq(&pdev->dev, priv->irq, pon_phy_isr,
+				       IRQF_SHARED, dev_name(&pdev->dev), priv);
+		if (ret) {
+			dev_warn(&pdev->dev,
+				 "Failed to request IRQ %d, using polling: %d\n",
+				 priv->irq, ret);
+			priv->irq = 0;
+		}
+	}
+
+	/* Start polling fallback timer */
+	timer_setup(&priv->poll_timer, pon_phy_poll_timer_fn, 0);
+	mod_timer(&priv->poll_timer,
+		  jiffies + msecs_to_jiffies(PON_PHY_POLL_MS));
+
+	pon_phy_debugfs_init(priv);
+
+	dev_info(&pdev->dev, "Airoha EN7512 PON PHY initialized\n");
+
+	return 0;
+}
+
+static void airoha_en7512_pon_remove(struct platform_device *pdev)
+{
+	struct airoha_en7512_pon *priv = platform_get_drvdata(pdev);
+
+	pon_phy_debugfs_remove(priv);
+	timer_delete_sync(&priv->poll_timer);
+
+	/* Disable firmware ready and all interrupts on shutdown */
+	pon_phy_fw_ready_set(priv, false);
+	pon_phy_wr(priv, XPON_INT_EN, 0);
+	pon_phy_wr(priv, XPON_INT_STA_CLR, XPON_INT_ALL);
+}
+
+static const struct of_device_id airoha_en7512_pon_of_match[] = {
+	{ .compatible = "airoha,en7512-pon-phy" },
+	{ .compatible = "airoha,en7521-pon-phy" },
+	{ .compatible = "airoha,en7526-pon-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, airoha_en7512_pon_of_match);
+
+static struct platform_driver airoha_en7512_pon_driver = {
+	.probe	= airoha_en7512_pon_probe,
+	.remove	= airoha_en7512_pon_remove,
+	.driver	= {
+		.name		= "airoha-en7512-pon-phy",
+		.of_match_table	= airoha_en7512_pon_of_match,
+		.dev_groups	= pon_phy_sysfs_groups,
+	},
+};
+module_platform_driver(airoha_en7512_pon_driver);
