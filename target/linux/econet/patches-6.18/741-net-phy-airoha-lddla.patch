+#define EN7571_DELTA_IAV_MAX		0x04	/* PWR_CTRL_8 byte 0 */
+#define EN7571_IMOD_IAVSCALE_MASK	0x80	/* PWR_CTRL_A byte 2 (disable TC) */
+
