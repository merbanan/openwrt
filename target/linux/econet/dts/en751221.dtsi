/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/clock/en7523-clk.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/reset/econet,en751221-reset.h>

/ {
	compatible = "econet,en751221";
	#address-cells = <1>;
	#size-cells = <1>;

	hpt_clock: clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;  /* 200 MHz */
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "mips,mips24KEc";
			reg = <0>;
		};
	};

	cpuintc: interrupt-controller {
		compatible = "mti,cpu-interrupt-controller";
		interrupt-controller;
		#address-cells = <0>;
		#interrupt-cells = <1>;
	};

	spi_ctrl: spi_controller@1fa10000 {
		compatible = "airoha,en7523-spi";
		reg = <0x1fa10000 0x140>;
		#address-cells = <1>;
		#size-cells = <0>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;

		nand: nand@0 {
			compatible = "spi-nand";
			reg = <0>;
			nand-ecc-engine = <&nand>;
		};
	};

	intc: interrupt-controller@1fb40000 {
		compatible = "econet,en751221-intc";
		reg = <0x1fb40000 0x100>;
		interrupt-parent = <&cpuintc>;
		interrupts = <2>;

		interrupt-controller;
		#interrupt-cells = <1>;
		econet,shadow-interrupts = <7 2>, <8 3>, <13 12>, <30 29>;
	};

	chip_scu: syscon@1fa20000 {
		compatible = "econet,en751221-chip-scu", "syscon";
		reg = <0x1fa20000 0x200>;
	};

	scuclk: clock-controller@1fa20000 {
		compatible = "econet,en751221-scu";
		reg = <0x1fb00000 0x10000>;
		#clock-cells = <1>;
		#reset-cells = <1>;

		scu_ssr: system-controller {
			compatible = "econet,en751221-scu-ssr";
		};

	};

	system-controller@1fbf0200 {
		compatible = "syscon", "simple-mfd";
		reg = <0x1fbf0200 0x100>;

		en751221_pinctrl: pinctrl {
			compatible = "econet,en751221-pinctrl";

			interrupt-parent = <&intc>;
			interrupts = <10>;

			gpio-controller;
			#gpio-cells = <2>;

			interrupt-controller;
			#interrupt-cells = <1>;
			gpio-ranges = <&en751221_pinctrl 0 13 29>;

			i2c_pins: i2c-pins {
				mux {
					function = "pon_i2c";
					groups = "pon_i2c";
				};

			};

		};
	};

	uart: serial@1fbf0000 {
		compatible = "ns16550";
		reg = <0x1fbf0000 0x30>;
		reg-io-width = <4>;
		reg-shift = <2>;
		interrupt-parent = <&intc>;
		interrupts = <0>;
		/*
		 * Conversion of baud rate to clock frequency requires a
		 * computation that is not in the ns16550 driver, so this
		 * uart is fixed at 115200 baud.
		 */
		clock-frequency = <1843200>;
	};

	timer_hpt: timer@1fbf0400 {
		compatible = "econet,en751221-timer";
		reg = <0x1fbf0400 0x100>;

		interrupt-parent = <&intc>;
		interrupts = <30>;
		clocks = <&hpt_clock>;
	};

	i2cclock: i2cclock@0 {
		#clock-cells = <0>;
		compatible = "fixed-clock";

		/* 20 MHz */
		clock-frequency = <20000000>;
	};

	i2c: i2c@1fbf8000 {
		compatible = "mediatek,mt7621-i2c";
		reg = <0x1fbf8000 0x100>;

		clocks = <&i2cclock>;

		/* 100 kHz */
		clock-frequency = <100000>;
		#address-cells = <1>;
		#size-cells = <0>;

		pinctrl-names = "default";
		pinctrl-0 = <&i2c_pins>;

		status = "okay";
	};

	usb0: usb@1fb90000 {
		compatible = "mediatek,mtk-xhci";
		reg = <0x1fb90000 0x3e00>,
			<0x1fa80700 0x100>;
		reg-names = "mac", "ippc";

		interrupt-parent = <&intc>;
		interrupts = <17>;
		interrupt-names = "host";

		phys = <&u2port0 PHY_TYPE_USB2>,
		       <&u3port0 PHY_TYPE_USB3>,
		       <&u2port1 PHY_TYPE_USB2>;

		usb3-lpm-capable;

		resets = <&scuclk EN751221_USB_HOST_RST>;
		reset-names = "usb_mac";

		status = "okay";
	};

	u3phy: t-phy@1FA80000 {
		compatible = "econet,en751221-usb-phy";
		reg = <0x1FA80000 0x700>;
		ranges;
		// status = "disabled";

		u2port0: usb-phy@1fa80800 {
			reg = <0x1fa80800 0x100>;
			#phy-cells = <1>;
			port-id = <0>;
			//phy-rev = <8>;
			// clocks = <&ssusbsys CLK_SSUSB_U2_PHY_EN>;
			// clock-names = "ref";
		};

		u3port0: usb-phy@1fa80900 {
			reg = <0x1fa80900 0x700>;
			#phy-cells = <1>;
			port-id = <0>;
			setup-25mhz-xtal;
			// clocks = <&clk25m>;
			// clock-names = "ref";
		};

		u2port1: usb-phy@1fa81000 {
			reg = <0x1fa81000 0x100>;
			#phy-cells = <1>;
			port-id = <1>;
			// phy-rev = <0>;
			// clocks = <&ssusbsys CLK_SSUSB_U2_PHY_1P_EN>;
			// clock-names = "ref";
		};
	};
};
