#
# NOTE (econet target overlay): this replaces the mainline
# drivers/net/ethernet/airoha/Kconfig to add NET_ECONET alongside the
# existing NET_AIROHA driver, and to allow the vendor menu on the EcoNet
# MIPS platform (ECONET). Keep in sync with the kernel's airoha Kconfig.
#
config NET_VENDOR_AIROHA
	bool "Airoha devices"
	default y
	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
	help
	  If you have a Airoha/EcoNet SoC with ethernet, say Y.

if NET_VENDOR_AIROHA

config NET_AIROHA_NPU
	tristate "Airoha NPU support"
	select WANT_DEV_COREDUMP
	select REGMAP_MMIO
	help
	  This driver supports Airoha Network Processor (NPU) available
	  on the Airoha Soc family.

config NET_AIROHA
	tristate "Airoha SoC Gigabit Ethernet support"
	depends on NET_DSA || !NET_DSA
	select NET_AIROHA_NPU
	select PAGE_POOL
	help
	  This driver supports the gigabit ethernet MACs in the
	  Airoha SoC family.

config NET_AIROHA_FLOW_STATS
	default y
	bool "Airoha flow stats"
	depends on NET_AIROHA && NET_AIROHA_NPU
	help
	  Enable Airoha flowtable statistic counters.

endif #NET_VENDOR_AIROHA

#
# The EcoNet EN751221 driver lives in this directory but is independent of
# the Airoha vendor driver above - it must build without NET_VENDOR_AIROHA
# (see the matching descend rule in drivers/net/ethernet/Makefile).
#
config NET_ECONET
	tristate "EcoNet EN751221 Gigabit Ethernet support"
	depends on ECONET || COMPILE_TEST
	depends on NET_DSA || !NET_DSA
	select PAGE_POOL
	select REGMAP_MMIO
	help
	  This driver supports the gigabit ethernet MAC, QDMA datapath and
	  PPE hardware flow offload on the EcoNet EN751221 SoC.

config ECONET_GPON
	tristate "EcoNet EN7521/EN7526 GPON MAC driver"
	depends on ECONET || COMPILE_TEST
	depends on OF
	depends on SFP
	help
	  Driver for the GPON MAC on EcoNet EN7521, EN7526 and EN751221 SoCs.
	  Implements ITU-T G.984.3 ONU activation, GEM port and T-CONT/Alloc-ID
	  management, downstream PLOAM handling and AES-128 decryption. It
	  attaches to an SFP socket specified in the device tree.

config ECONET_EPON
	tristate "EcoNet EN7521/EN7526 EPON MAC driver"
	depends on ECONET || COMPILE_TEST
	depends on OF
	depends on SFP
	help
	  Driver for the EPON MAC on EcoNet EN7521, EN7526 and EN751221 SoCs.
	  Implements IEEE 802.3 clause 64 MPCP LLID registration, triple-churning
	  and AES-128 security, dying gasp and power saving. It attaches to an
	  SFP socket specified in the device tree.
